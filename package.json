{
  "name": "@metalabel/dfos-api",
  "version": "0.9.1",
  "type": "module",
  "description": "Typed TypeScript client for the public DFOS API — a committed openapi.json snapshot, generated types, and a thin openapi-fetch client",
  "license": "MIT",
  "author": "DFOS Inc (https://dfos.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metalabel/dfos-api.git"
  },
  "homepage": "https://docs.dfos.com/api",
  "keywords": [
    "dfos",
    "api",
    "openapi",
    "client",
    "typescript",
    "metalabel"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.32.0+sha512.9b2634bb3fed5601c33633f2d92593f506270a3963b8c51d2b2d6a828da615ce4e9deebef9614ccebbc13ac8d3c0f9c9ccceb583c69c8578436fa477dbb20d70",
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit",
    "test": "vitest run",
    "generate": "openapi-typescript openapi.json -o src/generated/api.ts",
    "update-spec": "node scripts/update-spec.mjs && pnpm generate",
    "prepublishOnly": "pnpm build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "openapi-fetch": "^0.14.1"
  },
  "devDependencies": {
    "@metalabel/dfos-client": "0.33.0",
    "@types/node": "^24.10.4",
    "openapi-typescript": "^7.10.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript7": "npm:typescript@7.0.2",
    "vitest": "^4.1.8"
  }
}
